# Copy this file to .env (in the Jarvis folder) and fill in what you need. .env is never committed to git.
# Every setting can also go in %USERPROFILE%\.jarvis.json; real environment variables win over both.
# Keep comments on their own lines: a comment after an empty value would become the value.

# --- AI brains (at least one) ---
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Paid Claude API key (optional)
ANTHROPIC_API_KEY=
# Which brain to try first: gemini, ollama or claude (the others are backups)
JARVIS_AI_PROVIDER=gemini
JARVIS_OLLAMA_MODEL=llama3.2

# --- Voice ---
# edge = natural neural voice (online), windows = offline Windows voice
JARVIS_TTS_ENGINE=edge
# e.g. en-GB-RyanNeural, en-GB-SoniaNeural, en-IN-PrabhatNeural, en-US-GuyNeural
JARVIS_TTS_VOICE=en-GB-RyanNeural
# google, whisper (offline) or auto (Google, Whisper when offline)
JARVIS_STT_ENGINE=auto
# tiny.en (fastest), base.en, small.en (most accurate)
JARVIS_WHISPER_MODEL=base.en
JARVIS_LANGUAGE=en-IN

# --- Behaviour ---
# true = no "Jarvis" needed
JARVIS_ALWAYS_LISTEN=false
# carry out instructions silently
JARVIS_QUIET_ACTIONS=true
JARVIS_USER_TITLE=sir
JARVIS_CITY=Chennai
